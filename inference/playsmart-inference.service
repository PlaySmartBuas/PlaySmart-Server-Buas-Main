[Unit]
Description=Play-Smart Inference Service (FastAPI/Uvicorn)
# Make sure the SMB share is mounted before this service starts
After=network-online.target mnt-sftp_data.mount
Wants=network-online.target
Requires=mnt-sftp_data.mount

[Service]
Type=simple
User=inference
Group=inference
WorkingDirectory=/opt/play-smart-inference
Environment="PATH=/opt/play-smart-inference/venv/bin"
ExecStart=/opt/play-smart-inference/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
# Prevents a hung inference job from being silently killed too early
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
